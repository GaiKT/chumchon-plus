# Copy to .env and replace the passwords.
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# App connects as the restricted role (row-level security applies).
DATABASE_URL=postgres://chumchon_app:change-me-app@localhost:5432/chumchon
# Migrations and village management scripts connect as the table owner.
MIGRATION_DATABASE_URL=postgres://chumchon_owner:change-me-owner@localhost:5432/chumchon

# Temporary until login is in place (issue #02): which village the list page shows.
DEV_VILLAGE_ID=
